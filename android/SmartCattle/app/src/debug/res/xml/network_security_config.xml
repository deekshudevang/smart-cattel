<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug-only network security configuration -->
    <!-- Allows cleartext HTTP traffic to local developer machines and LAN IPs during debugging -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Local Dev Machine LAN IP (configured via DEV_LAN_IP in build.gradle.kts) -->
        <domain includeSubdomains="true">192.168.1.3</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
