# Environment Configuration Example

# API Server
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,*

# Database
DATABASE_URL=sqlite:///./smart_cattle.db

# Serial Port (Hardware communication)
SERIAL_PORT=COM6
SERIAL_BAUDRATE=9600

# Hardware Mode
HARDWARE_MODE=real
ALLOW_SIMULATION=false

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Notifications & Automatic SMS Alerts
# Configure your mobile number here (E.164 e.g. +91XXXXXXXXXX or 10-digit number):
ALERT_PHONE_NUMBER=+91XXXXXXXXXX
SMS_ALERT_ENABLED=true
SMS_PROVIDER=fast2sms

# SMS Gateway Credentials (Keep your private keys here, NEVER commit them to git)
# Fast2SMS (Free & Instant for India - https://www.fast2sms.com):
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio (International Gateway - https://www.twilio.com):
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# MSG91 (https://msg91.com):
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=SMTCAT
